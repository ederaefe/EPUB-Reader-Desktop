{
  "name": "semply-ebook-reader",
  "version": "1.0.3",
  "description": "Semply Ebook Reader - Clean, open cross-platform EPUB and document reader",
  "homepage": "https://semply.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ederaefe/EPUB-Reader-Desktop.git"
  },
  "main": "out/main/index.js",
  "author": "ederaefe",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --config electron-builder.config.cjs --publish never",
    "package:win": "electron-builder --win --config electron-builder.config.cjs --publish never",
    "package:mac": "electron-builder --mac --config electron-builder.config.cjs --publish never",
    "package:linux": "electron-builder --linux --config electron-builder.config.cjs --publish never",
    "release": "npm run build && npm run package",
    "release:win": "npm run build && npm run package:win",
    "prepare": "husky"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "electron-updater": "^6.8.11",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "mupdf": "^1.28.6",
    "pdfjs-dist": "^4.4.168",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
